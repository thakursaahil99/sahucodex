# =====================================================================================
# SahuCodeX — environment configuration
#
#   cp .env.example .env        (never commit .env — it is git-ignored)
#
# Everything below works locally with NO paid services. The values marked DEV ONLY are
# documented development credentials: change every one of them before exposing this
# deployment to anyone else (see docs/deployment.md).
# =====================================================================================

# ---- General -------------------------------------------------------------------------
APP_ENV=development              # development | production   (production enforces safe settings)
LOG_LEVEL=INFO
DOCS_ENABLED=true                # OpenAPI docs at /api/docs

# ---- PostgreSQL ----------------------------------------------------------------------
POSTGRES_USER=sahucodex
POSTGRES_PASSWORD=sahucodex_dev_password        # DEV ONLY
POSTGRES_DB=sahucodex
# Used when the API runs on your host. docker compose overrides this with the in-network host.
DATABASE_URL=postgresql://sahucodex:sahucodex_dev_password@localhost:5432/sahucodex

# ---- Redis ---------------------------------------------------------------------------
REDIS_PASSWORD=sahucodex_dev_redis              # DEV ONLY
REDIS_URL=redis://:sahucodex_dev_redis@localhost:6379/0

# ---- Authentication ------------------------------------------------------------------
# Must be >= 32 characters. Generate one with:  openssl rand -hex 32
# Production refuses to start while this still contains "change-me".
JWT_SECRET=dev-only-change-me-0f3a9c1d7b5e2a48c6d0e9f1b3a5c7d9      # DEV ONLY
JWT_ACCESS_EXPIRE=15m            # access-token lifetime (30s, 15m, 12h, 7d)
JWT_REFRESH_EXPIRE=7d            # refresh-token / session lifetime
REFRESH_REUSE_GRACE_SECONDS=10   # tolerated multi-tab refresh race before treating reuse as theft
EMAIL_VERIFY_EXPIRE=24h
PASSWORD_RESET_EXPIRE=1h
# COOKIE_SECURE=true             # defaults to true in production, false otherwise

# ---- HTTP / networking ---------------------------------------------------------------
# docker compose (Caddy reverse proxy):
WEB_PORT=3000                                    # the one published port. Change it if 3000 is taken...
PUBLIC_URL=http://localhost:3000                 # ...and keep this in step: it is what you type in the browser
HTTPS_ONLY=false                                 # true when served over TLS (enables HSTS + upgrade-insecure-requests)
API_PORT=8000                                    # API published on 127.0.0.1 only (docs, /health, /metrics)
POSTGRES_PORT=5432                               # published on 127.0.0.1 only
REDIS_PORT=6379                                  # published on 127.0.0.1 only

# When running the API on your host (not in docker) these two are read directly:
CORS_ORIGINS=http://localhost:3000               # comma-separated; also the Origin allow-list for cookie endpoints
FRONTEND_URL=http://localhost:3000               # used in emailed links
MAX_REQUEST_BYTES=1048576
# Admin endpoints (problem authoring, large hidden test files) may send bigger bodies, but only with a bearer token.
ADMIN_MAX_REQUEST_BYTES=8388608
# Number of trusted reverse proxies in front of the API. 0 = use the socket peer address (correct for
# `uvicorn` on your host, even behind `npm run dev`). docker compose sets 1: Caddy overwrites
# X-Forwarded-For with the true client address. Never set this above the real number of proxies —
# clients could then spoof their IP and dodge rate limits. (Next.js rewrites do NOT count as a proxy.)
TRUSTED_PROXY_COUNT=0
# Optional bearer token protecting GET /metrics (recommended in production).
METRICS_TOKEN=

# ---- Web (Next.js) -------------------------------------------------------------------
# `npm run dev` only: where Next.js proxies /api/* to. (In docker/production Caddy routes /api itself.)
API_INTERNAL_URL=http://localhost:8000

# ---- Rate limiting (Redis-backed; format: <count>/<second|minute|hour|day>) ------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5/minute                # per IP
RATE_LIMIT_LOGIN_ACCOUNT=10/hour         # per targeted account, across all IPs
RATE_LIMIT_REGISTER=5/minute             # per IP
RATE_LIMIT_PASSWORD_RESET=5/hour         # per IP and per email
RATE_LIMIT_GENERAL=300/minute            # per IP, all /api routes

# ---- Email ---------------------------------------------------------------------------
# console: prints emails (verification / reset links) to the API's stdout — development only.
# smtp:    sends through any SMTP server (e.g. self-hosted Mailpit for local testing).
EMAIL_BACKEND=console
EMAIL_FROM=SahuCodeX <no-reply@sahucodex.local>
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# ---- Seed data (database/seeds/run.py) -----------------------------------------------
# DEV ONLY credentials. Demo users are never created when APP_ENV=production; the admin is only
# created if SEED_ADMIN_PASSWORD (>= 12 characters) is set explicitly.
SEED_ON_START=true
SEED_PROBLEMS=true                # the 30 original practice problems + 23 topics (safe in any environment)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=sahuadmin
SEED_ADMIN_PASSWORD=Admin-dev-password-1
SEED_DEMO1_EMAIL=demo1@example.com
SEED_DEMO1_USERNAME=demo1
SEED_DEMO1_PASSWORD=Demo-dev-password-1
SEED_DEMO2_EMAIL=demo2@example.com
SEED_DEMO2_USERNAME=demo2
SEED_DEMO2_PASSWORD=Demo-dev-password-2

# ---- AI (SahuCodeX AI) — used from build phase 5 -----------------------------------
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=                    # choose any model you have pulled, e.g. `ollama pull <model>`

# ---- SahuJudge (build phase 3) --------------------------------------------------------
# Limits. Per-problem time and memory limits live on the problem itself; these are the platform-wide caps.
SUBMISSION_MAX_SOURCE_BYTES=65536       # source code size
RUN_MAX_INPUT_BYTES=65536               # custom input for the Run button
MAX_INFLIGHT_SUBMISSIONS=3              # queued + running submissions one user may have at once
RATE_LIMIT_SUBMIT=10/minute             # per user
RATE_LIMIT_RUN=20/minute                # per user
JUDGE_MAX_OUTPUT_BYTES=1048576          # a program printing more than this is a RUNTIME_ERROR
JUDGE_STALE_AFTER=15m                   # a job still queued/running after this is failed as SYSTEM_ERROR
# The sandbox. In compose the worker talks to the bundled dedicated daemon; this is set for you. Point it at your own
# dedicated host for production. NEVER point it at a daemon that also runs the application.
# SANDBOX_DOCKER_HOST=tcp://sandbox:2375
# SANDBOX_RUNTIME=runsc                 # run sandboxes under gVisor if installed on that host
SANDBOX_IMAGE=sahucodex/runner:1
SANDBOX_PIDS_LIMIT=64
SANDBOX_CPUS=1.0
